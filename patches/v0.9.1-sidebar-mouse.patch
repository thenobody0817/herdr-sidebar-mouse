+    fn sidebar_hover_target_at(&self, point: (u16, u16)) -> Option<ClientSidebarHoverTarget> {
+        if self.sidebar_collapsed {
+            return None;
+        }
+        if let Some((endpoint_id, pane_id)) = self
+            .hits
+            .endpoint_agents
+            .iter()
+            .find(|(rect, _, _)| super::contains(*rect, point))
+            .map(|(_, endpoint_id, pane_id)| (endpoint_id.clone(), pane_id.clone()))
+        {
+            return Some(ClientSidebarHoverTarget::Agent {
+                endpoint_id,
+                pane_id,
+            });
+        }
+        if let Some((_, pane_id)) = self
+            .hits
+            .agents
+            .iter()
+            .find(|(rect, _)| super::contains(*rect, point))
+        {
+            return Some(ClientSidebarHoverTarget::Agent {
+                endpoint_id: self.active_endpoint_id.clone(),
+                pane_id: pane_id.clone(),
+            });
+        }
+        self.hits
+            .workspaces
+            .iter()
+            .find(|hit| super::contains(hit.rect, point))
+            .map(|hit| ClientSidebarHoverTarget::Workspace {
+                endpoint_id: hit.endpoint_id.clone(),
+                workspace_id: hit.workspace_id.clone(),
+            })
+    }
+
+    fn sidebar_hover_interaction_active(&self) -> bool {
+        self.chrome_drag.is_some()
+            || self.workspace_press.is_some()
+            || self.tab_press.is_some()
+            || self.pane_mouse_gesture.is_some()
+            || self
+                .word_selection_gesture
+                .as_ref()
+                .is_some_and(|gesture| !gesture.released)
+            || self
+                .selection
+                .as_ref()
+                .is_some_and(crate::selection::Selection::is_dragging)
+    }
+
+    fn hover_sidebar(&mut self, mouse: MouseEvent, outcome: &mut ClientShellInput) {
+        if self.mode != ClientShellMode::Terminal || self.sidebar_hover_interaction_active() {
+            return;
+        }
+        let Some(target) = self.sidebar_hover_target_at((mouse.column, mouse.row)) else {
+            self.sidebar_hover = None;
+            return;
+        };
+        if self.sidebar_hover.as_ref() == Some(&target) {
+            return;
+        }
+        self.sidebar_hover = Some(target.clone());
+        let (endpoint_id, focus_target) = match target {
+            ClientSidebarHoverTarget::Workspace {
+                endpoint_id,
+                workspace_id,
+            } => (
+                endpoint_id,
+                ClientEndpointFocusTarget::Workspace(workspace_id),
+            ),
+            ClientSidebarHoverTarget::Agent {
+                endpoint_id,
+                pane_id,
+            } => (endpoint_id, ClientEndpointFocusTarget::Pane(pane_id)),
+        };
+        // Hovering a row on another machine must not silently switch machines.
+        if endpoint_id != self.active_endpoint_id {
+            return;
+        }
+        if self.focus_or_activate(endpoint_id, focus_target, outcome) {
+            outcome.repaint = true;
+        }
+    }
