+#[test]
+fn sidebar_mouse_hover_and_wheel_activate_workspaces() {
+    let mut projected = snapshot();
+    for (workspace_id, number) in [("ws_2", 2usize), ("ws_3", 3)] {
+        let mut workspace = projected.workspaces[0].clone();
+        workspace.workspace_id = workspace_id.into();
+        workspace.number = number;
+        workspace.focused = false;
+        projected.workspaces.push(workspace);
+    }
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("three workspaces");
+
+    let ws_1 = state.hits.workspaces[0].rect;
+    let ws_2 = state.hits.workspaces[1].rect;
+    let ws_3 = state.hits.workspaces[2].rect;
+    let point = |kind, rect: Rect| crossterm::event::MouseEvent {
+        kind,
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    };
+
+    let hovered = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::Moved,
+        ws_2,
+    ))]);
+    assert!(matches!(
+        &hovered.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_2")
+    ));
+
+    let down = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollDown,
+        ws_1,
+    ))]);
+    assert!(matches!(
+        &down.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_2")
+    ));
+
+    let up = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollUp,
+        ws_3,
+    ))]);
+    assert!(matches!(
+        &up.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_3")
+    ));
+}
