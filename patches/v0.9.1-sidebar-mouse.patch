+impl ClientSidebarHoverTarget {
+    pub(super) fn matches_workspace(
+        &self,
+        endpoint_id: &ClientEndpointId,
+        workspace_id: &str,
+    ) -> bool {
+        matches!(
+            self,
+            Self::Workspace {
+                endpoint_id: target_endpoint,
+                workspace_id: target_workspace,
+            } if target_endpoint == endpoint_id && target_workspace == workspace_id
+        )
+    }
+
+    pub(super) fn matches_agent(&self, endpoint_id: &ClientEndpointId, pane_id: &str) -> bool {
+        matches!(
+            self,
+            Self::Agent {
+                endpoint_id: target_endpoint,
+                pane_id: target_pane,
+            } if target_endpoint == endpoint_id && target_pane == pane_id
+        )
+    }
+}
