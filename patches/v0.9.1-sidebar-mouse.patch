+fn sidebar_mouse_hover_and_wheel_activate_workspaces() {
+    let mut projected = snapshot();
+    for (workspace_id, number) in [("ws_2", 2usize), ("ws_3", 3)] {
+        let mut workspace = projected.workspaces[0].clone();
+        workspace.workspace_id = workspace_id.into();
+        workspace.number = number;
+        workspace.focused = false;
+        projected.workspaces.push(workspace);
+    }
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("three workspaces");
+
+    let point = |kind, rect: Rect| crossterm::event::MouseEvent {
+        kind,
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    };
+
+    let first = state.hits.workspaces[0].rect;
+    let second = state.hits.workspaces[1].rect;
+    let third = state.hits.workspaces[2].rect;
+
+    let hovered = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::Moved,
+        second,
+    ))]);
+    assert!(hovered.actions.is_empty(), "hover must not focus");
+    assert!(matches!(
+        state.sidebar_hover,
+        Some(ClientSidebarHoverTarget::Workspace {
+            ref workspace_id,
+            ..
+        }) if workspace_id == "ws_2"
+    ));
+
+    // The wheel steps from the focused workspace (ws_1 -> ws_2), not the
+    // hovered one, and keeps the hover highlight.
+    let down = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollDown,
+        second,
+    ))]);
+    assert!(matches!(
+        &down.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_2")
+    ));
+    assert!(
+        state.sidebar_hover.is_some(),
+        "wheel keeps the hover highlight"
+    );
+
+    // Once the focus update lands, the next step continues from the new focus.
+    let mut update = state.snapshot.as_deref().expect("snapshot").clone();
+    update.revision += 1;
+    update.focused_workspace_id = Some("ws_2".into());
+    for workspace in &mut update.workspaces {
+        workspace.focused = workspace.workspace_id == "ws_2";
+    }
+    state.set_snapshot(Box::new(update));
+    let mut updated_surface = surface();
+    updated_surface.projection_revision = 2;
+    state.set_pane_surface(updated_surface);
+    state.compose(106, 20).expect("focused ws_2");
+    let down_again = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollDown,
+        third,
+    ))]);
+    assert!(matches!(
+        &down_again.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_3")
+    ));
+
+    // Hovering the first row while ws_2 is focused still steps from ws_2.
+    state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::Moved,
+        first,
+    ))]);
+    let up = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollUp,
+        first,
+    ))]);
+    assert!(matches!(
+        &up.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
