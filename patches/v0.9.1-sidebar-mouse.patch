+    /// Background used for the mouse-hover highlight on sidebar rows.
+    ///
+    /// Precedence: explicit `[theme.custom] hover_bg` > the current Omarchy
+    /// theme surface (`selection`, then `muted`, then `lighter_background`) >
+    /// a subtle mix of the host terminal background/foreground > the palette's
+    /// surface inset.
+    pub(super) fn resolved_hover_bg(&self) -> ratatui::style::Color {
+        use ratatui::style::Color;
+        if let Some(color) = self.config.hover_bg_override {
+            return color;
+        }
+        if self.config.theme_name == "terminal" {
+            if let Some(color) = self.omarchy_hover_bg {
+                return color;
+            }
+            return match (self.host_background, self.host_foreground) {
+                (Some(bg), Some(fg)) => mix_rgb(bg, fg, 0.12),
+                (Some(bg), None) => mix_rgb(
+                    bg,
+                    crate::terminal_theme::RgbColor {
+                        r: 255,
+                        g: 255,
+                        b: 255,
+                    },
+                    0.07,
+                ),
+                _ => Color::Indexed(238),
+            };
+        }
+        let palette = &self.config.palette;
+        if palette.surface1 != palette.active_row_bg && palette.surface1 != Color::Reset {
+            palette.surface1
+        } else if palette.surface0 != palette.active_row_bg && palette.surface0 != Color::Reset {
+            palette.surface0
+        } else {
+            Color::Indexed(238)
+        }
+    }
