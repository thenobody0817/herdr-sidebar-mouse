+fn sidebar_hover_paints_the_hovered_row_without_selecting() {
+    let mut projected = snapshot();
+    let mut second = projected.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.number = 2;
+    second.focused = false;
+    projected.workspaces.push(second);
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("two workspaces");
+
+    let ws_1 = state.hits.workspaces[0].rect;
+    let ws_2 = state.hits.workspaces[1].rect;
+    let outcome =
+        state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+            kind: MouseEventKind::Moved,
+            column: ws_2.x + 1,
+            row: ws_2.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+    assert!(outcome.actions.is_empty(), "hover must not focus");
+
+    let surface1 = state.config.palette.surface1;
+    let active = state.config.palette.active_row_bg;
+    let buffer = state
+        .compose(106, 20)
+        .expect("hover frame")
+        .to_ratatui_buffer()
+        .expect("hover buffer");
+    assert_eq!(buffer[(ws_2.x + 1, ws_2.y)].bg, surface1);
+    assert_eq!(buffer[(ws_1.x + 1, ws_1.y)].bg, active);
