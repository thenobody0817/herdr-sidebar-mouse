+
+fn mix_rgb(
+    start: crate::terminal_theme::RgbColor,
+    end: crate::terminal_theme::RgbColor,
+    amount: f32,
+) -> ratatui::style::Color {
+    let amount = amount.clamp(0.0, 1.0);
+    let mix = |a: u8, b: u8| (f32::from(a) * (1.0 - amount) + f32::from(b) * amount).round() as u8;
+    ratatui::style::Color::Rgb(
+        mix(start.r, end.r),
+        mix(start.g, end.g),
+        mix(start.b, end.b),
+    )
+}
+
+/// Read the current Omarchy theme's preferred subtle surface for hover.
+fn omarchy_hover_bg() -> Option<ratatui::style::Color> {
+    #[derive(serde::Deserialize)]
+    struct OmarchyColors {
+        selection: Option<String>,
+        muted: Option<String>,
+        lighter_background: Option<String>,
+    }
+
+    let home = std::env::var_os("HOME")?;
+    let path = std::path::Path::new(&home).join(".local/state/omarchy/current/theme/colors.toml");
+    let contents = std::fs::read_to_string(path).ok()?;
+    let colors: OmarchyColors = toml::from_str(&contents).ok()?;
+    colors
+        .selection
+        .or(colors.muted)
+        .or(colors.lighter_background)
+        .as_deref()
+        .map(crate::config::parse_color)
+}
