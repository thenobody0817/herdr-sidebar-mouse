+            return;
+        }
+        let target = self.sidebar_hover_target_at((mouse.column, mouse.row));
+        if self.sidebar_hover == target {
+            return;
+        }
+        // Hover only highlights the row; it never focuses or switches machines.
+        self.sidebar_hover = target;
+        outcome.repaint = true;
+    }
+
+    fn sidebar_step_workspace(&mut self, delta: isize, outcome: &mut ClientShellInput) {
+        if self.hits.workspaces.is_empty() {
+            return;
+        }
+        let anchor = self
+            .snapshot
+            .as_deref()
+            .and_then(|snapshot| {
+                let focused = snapshot.focused_workspace_id.as_deref()?;
+                self.hits.workspaces.iter().position(|hit| {
+                    hit.endpoint_id == self.active_endpoint_id && hit.workspace_id == focused
+                })
+            })
+            .unwrap_or(0);
+        let next =
+            (anchor as isize + delta).rem_euclid(self.hits.workspaces.len() as isize) as usize;
+        let (endpoint_id, workspace_id) = {
+            let hit = &self.hits.workspaces[next];
+            (hit.endpoint_id.clone(), hit.workspace_id.clone())
+        };
+        let already_focused = self.snapshot.as_deref().is_some_and(|snapshot| {
+            snapshot.focused_workspace_id.as_deref() == Some(workspace_id.as_str())
+                && endpoint_id == self.active_endpoint_id
+        });
+        if already_focused {
+            return;
+        }
+        self.reveal_workspace(&workspace_id);
+        if self.focus_or_activate(
+            endpoint_id,
+            ClientEndpointFocusTarget::Workspace(workspace_id),
+            outcome,
+        ) {
+            outcome.repaint = true;
+        }
+    }
