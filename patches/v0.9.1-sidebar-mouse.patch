+#[test]
+fn double_clicking_a_tab_closes_it() {
+    let mut projected = snapshot();
+    let mut second_tab = projected.tabs[0].clone();
+    second_tab.tab_id = "tab_2".into();
+    second_tab.number = 2;
+    second_tab.label = "2".into();
+    second_tab.focused = false;
+    projected.tabs.push(second_tab);
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("two tabs");
+    let rect = state.hits.tabs[1].0;
+    let click = |kind| {
+        RawInputEvent::Mouse(crossterm::event::MouseEvent {
+            kind,
+            column: rect.x + 1,
+            row: rect.y,
+            modifiers: KeyModifiers::empty(),
+        })
+    };
+
+    state.handle_raw_events(vec![click(MouseEventKind::Down(MouseButton::Left))]);
+    let first_click = state.handle_raw_events(vec![click(MouseEventKind::Up(MouseButton::Left))]);
+    assert!(matches!(
+        &first_click.actions[0],
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::TabFocus(target) if target.tab_id == "tab_2")
+    ));
+
+    state.handle_raw_events(vec![click(MouseEventKind::Down(MouseButton::Left))]);
+    let second_click = state.handle_raw_events(vec![click(MouseEventKind::Up(MouseButton::Left))]);
+    assert!(matches!(
+        &second_click.actions[0],
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::TabClose(target) if target.tab_id == "tab_2")
+    ));
+}
