+#[test]
+fn sidebar_mouse_hover_and_wheel_activate_agents() {
+    let mut projected = snapshot();
+    for (pane_id, focused) in [("pane_2", false), ("pane_3", false)] {
+        let mut pane = projected.panes[0].clone();
+        pane.pane_id = pane_id.into();
+        pane.focused = focused;
+        projected.panes.push(pane);
+    }
+    let agent = |pane_id: &str, focused: bool, seq: u64| ClientShellAgent {
+        pane_id: pane_id.into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: Some(pane_id.into()),
+        display_agent: None,
+        agent: Some("pi".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: seq,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused,
+    };
+    projected.agents = vec![
+        agent("pane_1", true, 1),
+        agent("pane_2", false, 2),
+        agent("pane_3", false, 3),
+    ];
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("three agents");
+
+    let first = state.hits.agents[0].0;
+    let second = state.hits.agents[1].0;
+    let third = state.hits.agents[2].0;
+    let point = |kind, rect: Rect| crossterm::event::MouseEvent {
+        kind,
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    };
+
+    let hovered = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::Moved,
+        second,
+    ))]);
+    assert!(matches!(
+        &hovered.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_2")
+    ));
+
+    let down = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollDown,
+        first,
+    ))]);
+    assert!(matches!(
+        &down.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_2")
+    ));
+
+    let up = state.handle_raw_events(vec![RawInputEvent::Mouse(point(
+        MouseEventKind::ScrollUp,
+        third,
+    ))]);
+    assert!(matches!(
+        &up.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_3")
+    ));
+}
